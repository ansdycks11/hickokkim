---
/**
 * Inner-page hero: charcoal with texture, breadcrumbs, a large serif title
 * followed by a hairline rule, and an optional link at the right end of it.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../layouts/Base.astro';

interface Props {
  breadcrumbs?: Crumb[];
  aside?: { label: string; href: string };
  lead?: string;
  /** Short items shown under the title, separated by slashes (e.g. title / practice). */
  sub?: { label: string; href?: string }[];
}
const { breadcrumbs, aside, lead, sub } = Astro.props;
---

<section class="page-hero dark" data-hero>
  <div class="wrap">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <div class="hero-title-row">
      <h1><slot /></h1>
      <span class="hero-rule" aria-hidden="true"></span>
      {aside && <a class="hero-aside chev" href={aside.href}>{aside.label}</a>}
    </div>
    {sub && sub.length > 0 && (
      <p class="hero-sub">
        {sub.map((s, i) => (
          <Fragment>
            {i > 0 && <span class="sep" aria-hidden="true">/</span>}
            {s.href ? <a class="textlink" href={s.href}>{s.label}</a> : <span>{s.label}</span>}
          </Fragment>
        ))}
      </p>
    )}
    {lead && <p class="hero-lead">{lead}</p>}
    <slot name="after" />
  </div>
</section>
