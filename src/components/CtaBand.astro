---
/**
 * Closing band on inner pages: curved photo panel left, navy panel right.
 * Photo: Walt Disney Concert Hall, Los Angeles, by Salvatore Favata on Unsplash
 * (Unsplash License), https://unsplash.com/photos/R1PkInr54KU — square crop.
 */
import { firm } from '../data/firm';
interface Props {
  heading?: string;
  text?: string;
  eyebrow?: string;
  action?: { label: string; href: string };
}
const {
  heading = 'The first conversation is free.',
  text = `Tell us briefly what's going on. A partner, not an intake service, responds ${firm.responsePromise}.`,
  eyebrow = 'Free consultation',
  action = { label: 'Request a free consultation', href: '/contact/' },
} = Astro.props;
---

<section class="feature" aria-labelledby="cta-h">
  <div class="feature__art feature__art--photo" aria-hidden="true">
    <img
      src="/assets/art/closing.webp"
      srcset="/assets/art/closing-sm.webp 700w, /assets/art/closing.webp 1200w"
      sizes="(min-width: 900px) 38vw, 100vw"
      width="1200"
      height="1200"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="feature__body dark">
    <span class="eyebrow">{eyebrow}</span>
    <h2 id="cta-h">{heading}</h2>
    <p>{text}</p>
    <div class="feature__actions">
      <a class="btn btn--solid" href={action.href}>{action.label}</a>
      <a class="btn" href={`tel:${firm.phoneTel}`}>Call {firm.phoneDisplay}</a>
    </div>
    <span class="feature__micro">Confidential · No obligation · Response within 1 business day</span>
  </div>
</section>
