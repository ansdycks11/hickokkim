---
/**
 * Fixed header: transparent over the white page top, solid white once the page scrolls.
 * Wordmark, consultation button, and a MENU button that opens a full-screen overlay
 * holding all navigation.
 */
import { firm } from '../data/firm';

interface Props { currentPath?: string }
const { currentPath = '' } = Astro.props;
const primary = [
  { label: 'Practice areas', href: '/practice-areas/' },
  { label: 'Attorneys', href: '/attorneys/' },
  { label: 'How we work', href: '/how-we-work/' },
  { label: 'Insights', href: '/insights/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Contact', href: '/contact/' },
];
const isCurrent = (href: string) => currentPath.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/">Hickok &amp; Kim<span class="visually-hidden">, Inc. home</span></a>
    <div class="header-right">
      <a class="btn header-cta" href="/contact/">Free consultation</a>
      <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="menuPanel" aria-label="Open menu">
        <span class="lines" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="label" aria-hidden="true">Menu</span>
      </button>
    </div>
  </div>
</header>

<nav class="menu-panel" id="menuPanel" aria-label="Site menu">
  <div class="wrap">
    <div class="menu-grid">
      <ul class="menu-primary">
        {primary.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <div class="menu-contact">
        <span class="eyebrow">Los Angeles</span>
        <address>
          {firm.address.street}<br />
          {firm.address.city}, {firm.address.region} {firm.address.postal}<br />
          {firm.address.note}<br />
          <a href={`tel:${firm.phoneTel}`}>{firm.phoneDisplay}</a><br />
          <a href={`mailto:${firm.email}`}>{firm.email}</a>
        </address>
        <a class="btn btn--solid" href="/contact/">Free consultation</a>
      </div>
    </div>
    <div class="menu-utility">
      <a href="/privacy-policy/">Privacy policy</a>
      <a href="/disclaimer/">Disclaimer</a>
      <span class="muted">Attorney advertising.</span>
    </div>
  </div>
</nav>

<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menuBtn') as HTMLButtonElement;
  const panel = document.getElementById('menuPanel')!;

  // Solid bar once the page scrolls off the top of the hero. Two thresholds (on past 48px,
  // off only back above 16px) so a scroll that hovers near one point, such as iOS's bounce
  // at the top of the page, cannot flip the bar back and forth.
  let solid = false;
  const onScroll = () => {
    const y = window.scrollY;
    const next = solid ? y > 16 : y > 48;
    if (next !== solid) { solid = next; header.classList.toggle('is-solid', solid); }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const focusables = () =>
    [btn, ...panel.querySelectorAll<HTMLElement>('a, button')].filter((el) => el.offsetParent !== null || el === btn);

  const setOpen = (open: boolean) => {
    panel.classList.toggle('open', open);
    document.body.classList.toggle('menu-open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) {
      panel.querySelector<HTMLElement>('.menu-primary a')?.focus();
    } else {
      btn.focus();
    }
  };

  btn.addEventListener('click', () => setOpen(!panel.classList.contains('open')));
  panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => {
    if (!panel.classList.contains('open')) return;
    if (e.key === 'Escape') { e.preventDefault(); setOpen(false); return; }
    if (e.key === 'Tab') {
      // keep focus inside the header button + menu while open
      const els = focusables();
      const first = els[0], last = els[els.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
</script>
