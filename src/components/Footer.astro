---
import { firm, moments, practiceAreas, partnerList, disclaimers, lastReviewedDisplay as reviewed } from '../data/firm';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <nav class="footer-strip" aria-label="Practice groups">
    {moments.map((m) => <a href={`/practice-areas/#${m.id}`}>{m.heading}</a>)}
  </nav>
  <div class="wrap">
    <div class="footer-main">
      <div>
        <h3>Los Angeles</h3>
        <!-- NAP block: must match the Google Business Profile exactly. -->
        <address>
          {firm.address.street}<br />
          {firm.address.city}, {firm.address.region} {firm.address.postal}<br />
          {firm.address.note}<br />
          <a href={`tel:${firm.phoneTel}`}>{firm.phoneDisplay}</a><br />
          <a href={`mailto:${firm.email}`}>{firm.email}</a><br />
          {firm.hoursDisplay}
        </address>
      </div>
      <div>
        <h3>Practice areas</h3>
        <ul>{practiceAreas.map((a) => <li><a href={a.path}>{a.name}</a></li>)}</ul>
      </div>
      <div>
        <h3>Firm</h3>
        <ul>
          {partnerList.map((p) => <li><a href={p.path}>{p.name}</a></li>)}
          <li><a href="/how-we-work/">How we work</a></li>
          <li><a href="/insights/">Insights</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <a class="wordmark" href="/">Hickok &amp; Kim</a>
      </div>
    </div>
    <div class="footer-legal">
      <span>© {year} {firm.name} {disclaimers.advertising}</span>
      <span>{disclaimers.licensed} {disclaimers.noRelationship} Last reviewed {reviewed}.</span>
      <span class="links">
        <a href="/privacy-policy/">Privacy policy</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </span>
    </div>
  </div>
</footer>
