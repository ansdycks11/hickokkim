---
/**
 * Practice-area page body (docs/website-architecture.md §6.2), in the
 * label-left section layout. Shared by the eight /practice-areas/<slug>/ pages
 * and /outside-general-counsel/.
 *
 * Everything is in the HTML. The long explanatory sections sit behind "+ More",
 * and situations and questions are accordions, so a person sees a short page
 * while crawlers and AI assistants still read every word.
 */
import Section from './Section.astro';
import Expandable from './Expandable.astro';
import LawyerList from './LawyerList.astro';
import CtaBand from './CtaBand.astro';
import type { PracticeContent } from '../data/practice/types';
import { practiceAreas, lastReviewedDisplay as reviewed, type PartnerSlug } from '../data/firm';

interface Props {
  content: PracticeContent;
  leads: PartnerSlug[];
  areaName: string;
}
const { content, leads, areaName } = Astro.props;
const related = content.related
  .map((slug) => practiceAreas.find((a) => a.slug === slug))
  .filter((a): a is NonNullable<typeof a> => !!a);
---

{content.verify && content.verify.length > 0 && (
  <Fragment set:html={`<!-- TODO:REAL-DATA — verify before launch and at each quarterly review:\n${content.verify.map((v) => `  - ${v.replace(/--/g, '- -')}`).join('\n')}\n-->`} />
)}

<Section label="Overview" tone="mist" id="overview">
  <p class="lead">{content.definition}</p>
  <div class="quick-answer">
    {content.quickAnswer.map((p) => <p>{p}</p>)}
  </div>
  {content.compliance && (
    <aside class="note-box" aria-label="Important notice">
      <span class="eyebrow">Please note</span>
      <p>{content.compliance}</p>
    </aside>
  )}
  <Expandable id="overview-more">
    <div class="prose">
      {content.sections.map((sec) => (
        <Fragment>
          <h3>{sec.heading}</h3>
          {sec.body.map((p) => <p>{p}</p>)}
          {sec.table && (
            <figure class="data-table">
              {sec.table.caption && <figcaption>{sec.table.caption}</figcaption>}
              <div class="table-scroll">
                <table>
                  <thead><tr><th scope="col">{sec.table.head[0]}</th><th scope="col">{sec.table.head[1]}</th></tr></thead>
                  <tbody>{sec.table.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td></tr>)}</tbody>
                </table>
              </div>
            </figure>
          )}
        </Fragment>
      ))}
    </div>
  </Expandable>
</Section>

<Section label="How we help" tone="white" id="how-we-help">
  <div class="services">
    {content.services.map((s) => <div><h3>{s.title}</h3><p>{s.body}</p></div>)}
  </div>
</Section>

<Section label="Common situations" tone="mist" id="situations">
  <p>The versions of this problem that arrive most often. If yours is not here, the consultation is still free.</p>
  <div class="accordion">
    {content.situations.map((s) => (
      <details>
        <summary><h3>{s.title}</h3></summary>
        <div class="answer"><p>{s.body}</p></div>
      </details>
    ))}
  </div>
</Section>

<Section label="Questions" tone="white" id="questions">
  <div class="accordion">
    {content.questions.map((qa) => (
      <details>
        <summary><h3>{qa.q}</h3></summary>
        <div class="answer"><p>{qa.a}</p></div>
      </details>
    ))}
  </div>
</Section>

<Section label="Professionals" tone="mist" id="professionals">
  <LawyerList slugs={leads} />
</Section>

<Section label="Sources" tone="white" id="sources">
  <p>Everything above is drawn from public California and federal sources. Follow them yourself, and tell us if something has changed.</p>
  <ul class="linklist">
    {content.citations.map((c) => <li><a href={c.url} rel="noopener">{c.label}</a><span class="note">{c.note}</span></li>)}
  </ul>
  <p class="reviewed">Last reviewed {reviewed}</p>
</Section>

{related.length > 0 && (
  <Section label="Related" tone="mist" id="related">
    <ul class="linklist">
      {related.map((a) => <li><a href={a.path}>{a.name}</a><span class="note">{a.blurb}</span></li>)}
    </ul>
  </Section>
)}

<CtaBand heading={`Talk to a partner about your ${areaName.toLowerCase()} matter.`} art={leads.includes('christopher-hickok') && !leads.includes('daniel-kim') ? 'contours-warm' : 'facade'} />
