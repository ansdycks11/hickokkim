---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { practiceAreas, firm } from '../data/firm';
---

<Base title="Page Not Found | Hickok & Kim — Los Angeles" description="That page does not exist. Find practice areas, attorneys, and contact information for Hickok & Kim, Inc." path="/404/" noindex>
  <PageHero>Page Not Found</PageHero>
  <Section label="Try these" tone="white">
    <p>The page you asked for isn't here. The links below cover most of what people are looking for, or call <a class="textlink" href={`tel:${firm.phoneTel}`}>{firm.phoneDisplay}</a>.</p>
    <ul class="linklist">
      {practiceAreas.map((a) => <li><a href={a.path}>{a.name}</a></li>)}
      <li><a href="/attorneys/">Attorneys</a></li>
      <li><a href="/how-we-work/">How we work</a></li>
      <li><a href="/faq/">Questions</a></li>
      <li><a href="/contact/">Contact and free consultation</a></li>
    </ul>
  </Section>
</Base>
