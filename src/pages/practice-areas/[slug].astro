---
/**
 * Practice-area page template (docs/website-architecture.md §6.2).
 * Content lives in src/data/practice/<slug>.ts; the body renders through
 * components/PracticePage.astro so this page and the featured
 * /outside-general-counsel/ page stay identical in structure.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PracticePage from '../../components/PracticePage.astro';
import { practiceAreas, partners, SITE_URL, FIRM_ID } from '../../data/firm';
import { contentFor } from '../../data/practice';

export function getStaticPaths() {
  return practiceAreas
    .filter((a) => a.path.startsWith('/practice-areas/'))
    .map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const content = contentFor(area.slug);
if (!content) {
  throw new Error(
    `No content for practice area "${area.slug}". Add src/data/practice/${area.slug}.ts exporting \`content\`.`
  );
}

const leads = area.partners.map((s) => partners[s]);
const crumbs = [
  { name: 'Practice areas', href: '/practice-areas/' },
  { name: area.name, href: area.path },
];

const serviceSchema = {
  '@type': 'Service',
  '@id': `${SITE_URL}${area.path}#service`,
  name: `${area.name} — Los Angeles`,
  serviceType: area.schemaName,
  description: content.definition,
  provider: { '@id': FIRM_ID },
  areaServed: { '@type': 'State', name: 'California' },
  url: `${SITE_URL}${area.path}`,
  offers: { '@type': 'Offer', description: 'Free initial consultation', price: '0', priceCurrency: 'USD' },
};

// Mirrors the visible question headings 1:1.
const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE_URL}${area.path}#faq`,
  mainEntity: content.questions.map((qa) => ({
    '@type': 'Question',
    name: qa.q,
    acceptedAnswer: { '@type': 'Answer', text: qa.a },
  })),
};
---

<Base
  title={content.title}
  description={content.description}
  path={area.path}
  breadcrumbs={crumbs}
  schema={[serviceSchema, faqSchema]}
>
  <PageHero
    kicker={`${area.ref} · ${leads.map((p) => p.name).join(' and ')}`}
    breadcrumbs={crumbs}
    cta
  >
    <Fragment set:html={content.h1} />
  </PageHero>

  <PracticePage content={content} leads={area.partners} areaName={area.name} />
</Base>
