---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { moments, areasByMoment, partners } from '../../data/firm';

const title = 'Practice Areas | Hickok & Kim Inc. — Los Angeles';
const description =
  'Nine practice areas for individuals and businesses in Los Angeles and across California, organized by the moment you are in: injury and litigation, business and cannabis, estates and property.';
const crumbs = [{ name: 'Practice areas', href: '/practice-areas/' }];
---

<Base title={title} description={description} path="/practice-areas/" breadcrumbs={crumbs}>
  <PageHero kicker="Practice areas" breadcrumbs={crumbs} lead="Hickok & Kim, Inc. handles nine practice areas for individuals and businesses across California, grouped by the moment a client is in. Each is led by the partner who signs your engagement letter. Every matter starts with a free consultation.">
    Nine practice areas, organized by the <em>moment</em> you're in.
  </PageHero>

  <section class="block tight" style="padding-top:clamp(40px,5vw,64px)">
    <div class="wrap">
      {moments.map((m) => (
        <div class="group reveal">
          <div class="group-head"><h2 style="font-size:1.55rem">{m.heading}</h2><p>{m.tagline}</p></div>
          <ul class="ledger">
            {areasByMoment(m.id).map((a) => (
              <li>
                <a class="row" href={a.path}>
                  <span class="ref">{a.ref}</span>
                  <h3 class="title">{a.shortName}<small>{a.partners.map((s) => partners[s].name).join(' and ')}</small></h3>
                  <p>{a.blurb}</p>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="fee-note">We do not handle criminal matters. If your situation falls outside what we do, we'll tell you and connect you with someone who can help.</p>
    </div>
  </section>

  <CtaBand />
</Base>
