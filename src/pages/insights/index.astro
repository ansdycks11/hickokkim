---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import CtaBand from '../../components/CtaBand.astro';
import { partners } from '../../data/firm';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const title = 'Insights | Hickok & Kim — Los Angeles';
const description =
  'Plain-language articles from the partners of Hickok & Kim, Los Angeles, on California business, cannabis, trademark, injury, and estate law.';
const crumbs = [{ name: 'Insights', href: '/insights/' }];
---

<Base title={title} description={description} path="/insights/" breadcrumbs={crumbs}>
  <PageHero breadcrumbs={crumbs}>Insights</PageHero>

  <Section label="Overview" tone="mist">
    <p class="lead">Articles written by the partners, cited to the statute or agency, and reviewed every quarter.</p>
  </Section>

  <Section label="Articles" tone="white">
    {posts.length === 0 ? (
      <p class="placeholder">Three seed articles are written in Phase 5. The list appears here automatically.</p>
    ) : (
      <ul class="articles">
        {posts.map((post) => (
          <li>
            <span class="eyebrow">{fmt(post.data.published)} · {partners[post.data.author].name}</span>
            <h3><a href={`/insights/${post.id}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </Section>

  <CtaBand />
</Base>

<style>
  .articles { list-style: none; border-top: 1px solid var(--hair); }
  .articles li { padding: 26px 0; border-bottom: 1px solid var(--hair); }
  .articles h3 { font-size: 1.5rem; margin: 6px 0 8px; }
  .articles h3 a { color: var(--accent); text-decoration: none; }
  .articles h3 a:hover { text-decoration: underline; }
</style>
