---
/**
 * Home. A split-screen opening (Los Angeles photograph left, charcoal panel right),
 * followed by label-left sections.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import LawyerList from '../components/LawyerList.astro';
import IntakeForm from '../components/IntakeForm.astro';
import { firm, moments, areasByMoment, partnerList, partners, testimonials } from '../data/firm';

const title = 'Hickok & Kim, Inc. — Los Angeles Attorneys for Individuals and Businesses';
const description =
  'Hickok & Kim is a Los Angeles law firm for individuals and businesses across California: injury, litigation, business, cannabis, trademarks, estates. Free consultation.';

// Photo: Shea Rouda on Unsplash (Unsplash License), taken from the top of Los Angeles City Hall.
// https://unsplash.com/photos/Vtl6cOhO87Y — the skyline sits in the lower part of the frame, so
// object-position keeps it in view when phones crop the photo to a short, wide panel.
// On desktop the panel is taller than the photo's shape, so the photo fills its height and
// renders about 0.86 x the viewport height wide; sizes says so, so high-resolution screens
// get a large enough file. Files come from the 2000 px original (see README, Photography).
const heroImg = {
  src: '/assets/art/la-photo.webp',
  srcset: '/assets/art/la-photo-sm.webp 800w, /assets/art/la-photo-md.webp 1200w, /assets/art/la-photo-lg.webp 1600w, /assets/art/la-photo.webp 2000w',
  w: 2000,
  h: 2320,
  pos: '50% 90%',
};
const heroLinks = [
  { label: 'Practice areas', href: '/practice-areas/' },
  { label: 'Our lawyers', href: '/attorneys/' },
  { label: 'Visit or call', href: '/contact/' },
];

const steps = [
  { t: 'Free consultation', d: "A call or video meeting where we listen, ask questions, and tell you plainly whether we're the right firm. If we're not, we'll point you to someone who is." },
  { t: 'Retainer and conflict check', d: 'A written retainer agreement and conflict waiver before any work begins, with the fee structure spelled out: hourly, flat, or contingency.' },
  { t: 'Strategy and itemized invoices', d: 'A clear plan, itemized invoices, and a partner who returns calls the same day in nearly every case.' },
  { t: 'Resolution', d: 'Settlement, signature, filing, or judgment. We drive matters to a defined end and hand you the complete file.' },
];

const faqs = [
  { q: 'Is the initial consultation free?', a: 'Yes. Every matter begins with a free initial consultation by phone or video, so we can understand your situation and tell you plainly whether and how we can help.' },
  { q: 'How are fees structured?', a: 'Hourly, flat-fee, or contingency depending on the matter. Personal injury cases are handled on contingency, so you pay nothing unless we recover for you. Every engagement starts with a written retainer agreement and conflict check, and invoices are itemized.' },
  { q: 'Do you meet clients in person?', a: 'Yes, by appointment. Our Los Angeles office at 2202 S. Figueroa St. is used for scheduled meetings, and we work with clients throughout California by phone and video.' },
  { q: 'Do you offer services in Korean?', a: 'Yes. Partner Daniel Kim speaks Korean and can handle consultations and matters in Korean.' },
];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base title={title} description={description} path="/" schema={[faqSchema]} bodyClass="is-home">
  <!-- ================= OPENING ================= -->
  <section class="showcase dark" data-hero aria-labelledby="showcase-h">
    <div class="showcase__art" aria-hidden="true">
      <img
        class="showcase__img"
        src={heroImg.src}
        srcset={heroImg.srcset}
        sizes="(min-width: 900px) max(40vw, 86vh), 100vw"
        width={heroImg.w}
        height={heroImg.h}
        alt=""
        style={`object-position:${heroImg.pos}`}
        fetchpriority="high"
      />
    </div>
    <div class="showcase__panel">
      <h1 class="showcase__h1" id="showcase-h">Los Angeles attorneys for individuals and businesses</h1>
      <p class="showcase__title">Los Angeles counsel, from the first call to the final signature.</p>
      <p class="showcase__blurb">Two partners on South Figueroa Street representing individuals and businesses across California, in English and Korean.</p>
      <ul class="showcase__links">
        {heroLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <p class="showcase__who">{partners['daniel-kim'].name} and {partners['christopher-hickok'].name}</p>
      <div class="showcase__actions">
        <a class="btn btn--solid" href="/contact/">Free consultation</a>
      </div>
    </div>
  </section>

  <!-- ================= OVERVIEW ================= -->
  <Section label="Overview" tone="white">
    <p class="lead reveal">Hickok &amp; Kim, Inc. is a Los Angeles law firm founded in 2019 by two partners who answer their own phones. We represent individuals and businesses across California, in English and Korean, and every matter begins with a free consultation.</p>
    <ul class="stats reveal">
      <li><b>2019</b><span>Founded in Los Angeles</span></li>
      <li><b>18+ years</b><span>Combined experience</span></li>
      <li><b>9</b><span>Practice areas</span></li>
      <li><b>California</b><span>Statewide, by video or in person</span></li>
    </ul>
  </Section>

  <!-- ================= PRACTICE AREAS ================= -->
  <Section label="Practice areas" tone="mist" id="practice">
    {moments.map((m) => (
      <div class="group reveal">
        <h3 class="group__title">{m.heading}</h3>
        <ul class="linklist">
          {areasByMoment(m.id).map((a) => <li><a href={a.path}>{a.name}</a></li>)}
        </ul>
      </div>
    ))}
    <p class="muted">We do not handle criminal matters. If your situation falls outside what we do, we'll tell you and connect you with someone who can help.</p>
  </Section>

  <!-- ================= FEATURED SERVICE ================= -->
  <section class="feature" aria-labelledby="ogc-h">
    <div class="feature__art" style="--art:url('/assets/art/facade.webp')" role="presentation"></div>
    <div class="feature__body dark">
      <span class="eyebrow">Featured service</span>
      <h2 id="ogc-h">Outside general counsel: your company's legal department, without the in-house cost.</h2>
      <div class="feature__actions"><a class="btn chev" href="/outside-general-counsel/">About outside general counsel</a></div>
    </div>
  </section>

  <!-- ================= LAWYERS ================= -->
  <Section label="Lawyers" tone="white" id="attorneys">
    <p class="reveal">Two partners and no associates. The partner who takes your consultation is the partner who does the work and signs your engagement letter.</p>
    <LawyerList slugs={partnerList.map((p) => p.slug)} />
  </Section>

  {testimonials.length > 0 && (
    <Section label="Clients" tone="mist">
      {testimonials.map((t) => (
        <figure class="reveal"><blockquote class="lead">{t.quote}</blockquote><figcaption class="muted">{t.attribution}</figcaption></figure>
      ))}
    </Section>
  )}

  <!-- ================= PROCESS ================= -->
  <Section label="How we work" tone="mist" id="process">
    <ol class="steps reveal">
      {steps.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}
    </ol>
    <p><a class="textlink chev" href="/how-we-work/">Fees and process in detail</a></p>
  </Section>

  <!-- ================= FAQ ================= -->
  <Section label="Questions" tone="white" id="faq">
    <div class="accordion">
      {faqs.map((f) => (
        <details>
          <summary><h3>{f.q}</h3></summary>
          <div class="answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
    <p><a class="textlink chev" href="/faq/">All questions</a></p>
  </Section>

  <!-- ================= CONTACT ================= -->
  <Section label="Contact" tone="dark" id="contact">
    <div class="contact-split">
      <div>
        <p class="lead">The first conversation is free.</p>
        <address class="contact-address">
          {firm.address.street}<br />
          {firm.address.city}, {firm.address.region} {firm.address.postal}<br />
          {firm.address.note}<br />
          <a href={`tel:${firm.phoneTel}`}>{firm.phoneDisplay}</a><br />
          <a href={`mailto:${firm.email}`}>{firm.email}</a><br />
          {firm.hoursDisplay}<br />
          {firm.hoursNote}
        </address>
      </div>
      <div class="on-dark"><IntakeForm /></div>
    </div>
  </Section>
</Base>

<style>
  /* ---------- showcase ---------- */
  .showcase { position: relative; background: var(--charcoal); color: #fff; display: grid; grid-template-columns: 1fr; min-height: 100svh; }
  @media (min-width: 900px) { .showcase { grid-template-columns: minmax(0, 40%) minmax(0, 1fr); } }
  .showcase__art { position: relative; min-height: 38svh; overflow: hidden; }
  /* Desktop: one full-bleed panel whose right edge is a gentle convex curve,
     a single continuous shape rather than a pointed chevron. The ellipse is
     centred on the left edge and exactly as wide as the panel, so the curve
     touches the full width at mid-height and eases back about 9% at top and bottom. */
  @media (min-width: 900px) { .showcase__art { clip-path: ellipse(100% 120% at 0% 50%); } }
  /* A shade at the top keeps the header legible where it overlaps the artwork (mobile). */
  .showcase__art::after { content: ""; position: absolute; inset: 0 0 auto 0; height: 140px; z-index: 1; background: linear-gradient(rgba(20, 20, 20, .6), rgba(20, 20, 20, 0)); }
  @media (min-width: 900px) { .showcase__art::after { display: none; } }
  /* Desktop: start the header content where the charcoal panel starts, so the white
     wordmark never sits on the pale artwork. Once the header turns solid it realigns. */
  @media (min-width: 900px) {
    :global(.is-home .site-header:not(.is-solid) .bar) { max-width: none; padding-left: calc(40% + clamp(24px, 6vw, 96px)); }
  }
  .showcase__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .showcase__panel { position: relative; display: flex; flex-direction: column; justify-content: center; padding: calc(var(--header-h) + 24px) var(--gutter) 40px clamp(24px, 6vw, 96px); }
  .showcase__panel > * { max-width: 640px; }
  @media (max-width: 899px) { .showcase__panel { padding-top: 40px; } }
  .showcase__h1 { font-family: var(--sans); font-weight: 500; font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--on-dark-muted); margin-bottom: clamp(18px, 3.5vh, 32px); }
  .showcase__title { font-family: var(--serif); font-weight: 400; color: #fff; font-size: clamp(2rem, 3.6vw, 3.2rem); line-height: 1.15; text-wrap: balance; }
  .showcase__blurb { margin-top: 18px; color: #cfcfcf; font-size: 1.05rem; max-width: 52ch; }
  .showcase__links { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 22px; margin-top: 22px; }
  .showcase__links a { color: #fff; text-decoration: none; font-size: .95rem; border-bottom: 1px solid rgba(201, 168, 106, .6); padding-bottom: 2px; }
  .showcase__links a:hover { color: var(--accent-on-dark); }
  .showcase__who { margin-top: 18px; font-size: .85rem; color: var(--on-dark-muted); }
  .showcase__actions { margin-top: clamp(28px, 5vh, 48px); }
  @media (max-width: 520px) { .showcase__actions .btn { width: 100%; } }

  /* ---------- contact ---------- */
  .contact-split { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .contact-split { grid-template-columns: .8fr 1.2fr; gap: 64px; } }
  .contact-address { font-style: normal; line-height: 1.9; margin-top: 18px; }
  .contact-address a { color: var(--accent-on-dark); text-decoration: none; }
  .contact-address a:hover { text-decoration: underline; }
</style>
