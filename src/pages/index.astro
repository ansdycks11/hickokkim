---
/**
 * Home. A split-screen showcase (angled artwork left, charcoal panel right)
 * cycles through the three client moments, followed by label-left sections.
 * All slide text is in the HTML for crawlers; only one slide is shown at a time.
 */
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import LawyerList from '../components/LawyerList.astro';
import IntakeForm from '../components/IntakeForm.astro';
import { firm, moments, areasByMoment, partnerList, partners, testimonials } from '../data/firm';

const title = 'Hickok & Kim, Inc. — Los Angeles Attorneys for Individuals and Businesses';
const description =
  'Hickok & Kim is a Los Angeles law firm for individuals and businesses across California: injury, litigation, business, cannabis, trademarks, estates. Free consultation.';

const slides = [
  { moment: moments[0], art: 'louvers', blurb: 'Injury claims and civil disputes, handled from the first letter to resolution by the partner who takes your call.', who: ['daniel-kim'] as const },
  { moment: moments[1], art: 'facade', blurb: 'Formation, contracts, ongoing counsel, and the brands and licenses your business runs on.', who: ['daniel-kim', 'christopher-hickok'] as const },
  { moment: moments[2], art: 'contours-warm', blurb: "Wills, trusts, and the property that holds a family's work, planned so it passes without a fight.", who: ['daniel-kim'] as const },
];

const steps = [
  { t: 'Free consultation', d: "A call or video meeting where we listen, ask questions, and tell you plainly whether we're the right firm. If we're not, we'll point you to someone who is." },
  { t: 'Retainer and conflict check', d: 'A written retainer agreement and conflict waiver before any work begins, with the fee structure spelled out: hourly, flat, or contingency.' },
  { t: 'Strategy and itemized invoices', d: 'A clear plan, itemized invoices, and a partner who returns calls the same day in nearly every case.' },
  { t: 'Resolution', d: 'Settlement, signature, filing, or judgment. We drive matters to a defined end and hand you the complete file.' },
];

const faqs = [
  { q: 'Is the initial consultation free?', a: 'Yes. Every matter begins with a free initial consultation by phone or video, so we can understand your situation and tell you plainly whether and how we can help.' },
  { q: 'How are fees structured?', a: 'Hourly, flat-fee, or contingency depending on the matter. Personal injury cases are handled on contingency, so you pay nothing unless we recover for you. Every engagement starts with a written retainer agreement and conflict check, and invoices are itemized.' },
  { q: 'Do you meet clients in person?', a: 'Yes, by appointment. Our Los Angeles office at 2202 S. Figueroa St. is used for scheduled meetings, and we work with clients throughout California by phone and video.' },
  { q: 'Do you offer services in Korean?', a: 'Yes. Partner Daniel Kim speaks Korean and can handle consultations and matters in Korean.' },
];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base title={title} description={description} path="/" schema={[faqSchema]} bodyClass="is-home">
  <link slot="head" rel="preload" as="image" href="/assets/art/louvers.webp" fetchpriority="high" />

  <!-- ================= SHOWCASE ================= -->
  <section class="showcase dark" data-hero aria-roledescription="carousel" aria-label="Hickok & Kim at a glance">
    <div class="showcase__art" aria-hidden="true">
      {slides.map((s, i) => (
        <div class={`showcase__img ${i === 0 ? 'is-active' : ''}`} style={`background-image:url('/assets/art/${s.art}.webp')`}></div>
      ))}
    </div>
    <div class="showcase__panel">
      <h1 class="showcase__h1">Los Angeles attorneys for individuals and businesses</h1>
      <div class="showcase__slides">
        {slides.map((s, i) => (
          <article class={`slide ${i === 0 ? 'is-active' : ''}`} id={`slide-${i}`} aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} aria-hidden={i === 0 ? undefined : 'true'}>
            <p class="eyebrow">{s.moment.heading}</p>
            <h2 class="slide__title">{s.moment.line}</h2>
            <p class="slide__blurb">{s.blurb}</p>
            <ul class="slide__areas">
              {areasByMoment(s.moment.id).map((a) => <li><a href={a.path} tabindex={i === 0 ? undefined : -1}>{a.name}</a></li>)}
            </ul>
            <p class="slide__who">{s.who.map((w) => partners[w].name).join(' and ')}</p>
          </article>
        ))}
      </div>
      <div class="showcase__controls">
        <button class="ctl" type="button" data-dir="-1" aria-label="Previous slide"><span aria-hidden="true">&#8592;</span></button>
        <span class="counter" aria-live="polite"><b id="slideNum">01</b> / 0{slides.length}</span>
        <button class="ctl" type="button" data-dir="1" aria-label="Next slide"><span aria-hidden="true">&#8594;</span></button>
        <a class="btn btn--solid showcase__cta" href="/contact/">Free consultation</a>
      </div>
    </div>
  </section>

  <!-- ================= OVERVIEW ================= -->
  <Section label="Overview" tone="white">
    <p class="lead reveal">Hickok &amp; Kim, Inc. is a Los Angeles law firm founded in 2019 by two partners who answer their own phones. We represent individuals and businesses across California, in English and Korean, and every matter begins with a free consultation.</p>
    <ul class="stats reveal">
      <li><b>2019</b><span>Founded in Los Angeles</span></li>
      <li><b>18+ years</b><span>Combined experience</span></li>
      <li><b>9</b><span>Practice areas</span></li>
      <li><b>California</b><span>Statewide, by video or in person</span></li>
    </ul>
  </Section>

  <!-- ================= PRACTICE AREAS ================= -->
  <Section label="Practice areas" tone="mist" id="practice">
    {moments.map((m) => (
      <div class="group reveal">
        <h3 class="group__title">{m.heading}</h3>
        <ul class="linklist">
          {areasByMoment(m.id).map((a) => <li><a href={a.path}>{a.name}</a><span class="note">{a.ledgerNote}</span></li>)}
        </ul>
      </div>
    ))}
    <p class="muted">We do not handle criminal matters. If your situation falls outside what we do, we'll tell you and connect you with someone who can help.</p>
  </Section>

  <!-- ================= FEATURED SERVICE ================= -->
  <section class="feature" aria-labelledby="ogc-h">
    <div class="feature__art" style="--art:url('/assets/art/facade.webp')" role="presentation"></div>
    <div class="feature__body dark">
      <span class="eyebrow">Featured service</span>
      <h2 id="ogc-h">Outside general counsel: your company's legal department, without the in-house cost.</h2>
      <p>Ongoing contract review, advice while decisions are still open, and disputes handled by the same two partners who already know your business.</p>
      <div class="feature__actions"><a class="btn chev" href="/outside-general-counsel/">About outside general counsel</a></div>
    </div>
  </section>

  <!-- ================= LAWYERS ================= -->
  <Section label="Lawyers" tone="white" id="attorneys">
    <p class="reveal">Two partners and no associates. The partner who takes your consultation is the partner who does the work and signs your engagement letter.</p>
    <LawyerList slugs={partnerList.map((p) => p.slug)} />
  </Section>

  {testimonials.length > 0 && (
    <Section label="Clients" tone="mist">
      {testimonials.map((t) => (
        <figure class="reveal"><blockquote class="lead">{t.quote}</blockquote><figcaption class="muted">{t.attribution}</figcaption></figure>
      ))}
    </Section>
  )}

  <!-- ================= PROCESS ================= -->
  <Section label="How we work" tone="mist" id="process">
    <ol class="steps reveal">
      {steps.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}
    </ol>
    <p><a class="textlink chev" href="/how-we-work/">Fees and process in detail</a></p>
  </Section>

  <!-- ================= FAQ ================= -->
  <Section label="Questions" tone="white" id="faq">
    <div class="accordion">
      {faqs.map((f) => (
        <details>
          <summary><h3>{f.q}</h3></summary>
          <div class="answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
    <p><a class="textlink chev" href="/faq/">All questions</a></p>
  </Section>

  <!-- ================= CONTACT ================= -->
  <Section label="Contact" tone="dark" id="contact">
    <div class="contact-split">
      <div>
        <p class="lead">The first conversation is free.</p>
        <address class="contact-address">
          {firm.address.street}<br />
          {firm.address.city}, {firm.address.region} {firm.address.postal}<br />
          {firm.address.note}<br />
          <a href={`tel:${firm.phoneTel}`}>{firm.phoneDisplay}</a><br />
          <a href={`mailto:${firm.email}`}>{firm.email}</a><br />
          {firm.hoursDisplay}<br />
          {firm.hoursNote}
        </address>
      </div>
      <div class="on-dark"><IntakeForm /></div>
    </div>
  </Section>
</Base>

<style>
  /* ---------- showcase ---------- */
  .showcase { position: relative; background: var(--charcoal); color: #fff; display: grid; grid-template-columns: 1fr; min-height: 100svh; }
  @media (min-width: 900px) { .showcase { grid-template-columns: minmax(0, 40%) minmax(0, 1fr); } }
  .showcase__art { position: relative; min-height: 38svh; overflow: hidden; }
  /* Desktop: the artwork sits inset like a framed print, with a thin brass frame
     offset down and to the right behind it. */
  @media (min-width: 900px) {
    .showcase__art { overflow: visible; }
    .showcase__art::before {
      content: ""; position: absolute; border: 1px solid rgba(201, 168, 106, .55);
      inset: calc(var(--header-h) + 34px) 10px 34px calc(var(--gutter) + 22px);
    }
  }
  /* A shade at the top keeps the header legible where it overlaps the artwork (mobile). */
  .showcase__art::after { content: ""; position: absolute; inset: 0 0 auto 0; height: 140px; z-index: 1; background: linear-gradient(rgba(20, 20, 20, .6), rgba(20, 20, 20, 0)); }
  @media (min-width: 900px) { .showcase__art::after { display: none; } }
  .showcase__img { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0; transform: scale(1.04); transition: opacity 1s var(--ease), transform 6s linear; }
  /* Inset below the header, so the wordmark always sits on charcoal. */
  /* No zoom when framed: a scaled image would briefly spill past its frame. */
  @media (min-width: 900px) { .showcase__img { inset: calc(var(--header-h) + 12px) 32px 56px var(--gutter); transform: none; } }
  .showcase__img.is-active { opacity: 1; transform: scale(1); }
  .showcase__panel { position: relative; display: flex; flex-direction: column; justify-content: center; padding: calc(var(--header-h) + 24px) var(--gutter) 40px clamp(24px, 6vw, 96px); }
  @media (max-width: 899px) { .showcase__panel { padding-top: 40px; } .showcase__art { margin-top: 0; } }
  .showcase__h1 { font-family: var(--sans); font-weight: 500; font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; color: var(--on-dark-muted); margin-bottom: clamp(20px, 4vh, 40px); }
  .showcase__slides { display: grid; }
  .slide { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(12px); transition: opacity .7s var(--ease), transform .7s var(--ease), visibility 0s linear .7s; max-width: 640px; }
  .slide.is-active { opacity: 1; visibility: visible; transform: none; transition: opacity .7s var(--ease) .15s, transform .7s var(--ease) .15s; }
  .slide .eyebrow { color: var(--accent-on-dark); margin-bottom: 14px; }
  .slide__title { color: #fff; font-size: clamp(2rem, 3.6vw, 3.2rem); line-height: 1.15; }
  .slide__blurb { margin-top: 18px; color: #cfcfcf; font-size: 1.05rem; max-width: 52ch; }
  .slide__areas { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 22px; margin-top: 22px; }
  .slide__areas a { color: #fff; text-decoration: none; font-size: .95rem; border-bottom: 1px solid rgba(201, 168, 106, .6); padding-bottom: 2px; }
  .slide__areas a:hover { color: var(--accent-on-dark); }
  .slide__who { margin-top: 18px; font-size: .85rem; color: var(--on-dark-muted); }
  .showcase__controls { display: flex; align-items: center; gap: 16px; margin-top: clamp(28px, 5vh, 56px); flex-wrap: wrap; }
  .ctl { width: 48px; height: 48px; border: 1px solid rgba(255, 255, 255, .35); color: #fff; font-size: 1.1rem; transition: border-color .2s, color .2s; }
  .ctl:hover { border-color: var(--accent-on-dark); color: var(--accent-on-dark); }
  .counter { font-size: .9rem; color: var(--on-dark-muted); letter-spacing: .08em; min-width: 64px; text-align: center; }
  .counter b { color: #fff; font-weight: 500; }
  .showcase__cta { margin-left: auto; }
  @media (max-width: 520px) { .showcase__cta { margin-left: 0; width: 100%; } }
  @media (prefers-reduced-motion: reduce) {
    .showcase__img, .slide, .slide.is-active { transition: none; transform: none; }
  }

  /* ---------- contact ---------- */
  .contact-split { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .contact-split { grid-template-columns: .8fr 1.2fr; gap: 64px; } }
  .contact-address { font-style: normal; line-height: 1.9; margin-top: 18px; }
  .contact-address a { color: var(--accent-on-dark); text-decoration: none; }
  .contact-address a:hover { text-decoration: underline; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.showcase');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const imgs = [...root.querySelectorAll<HTMLElement>('.showcase__img')];
    const num = document.getElementById('slideNum')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, timer: number | undefined;

    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === i;
        s.classList.toggle('is-active', on);
        on ? s.removeAttribute('aria-hidden') : s.setAttribute('aria-hidden', 'true');
        s.querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      imgs.forEach((im, k) => im.classList.toggle('is-active', k === i));
      num.textContent = String(i + 1).padStart(2, '0');
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const start = () => { if (!reduced && !timer) timer = window.setInterval(() => show(i + 1), 8000); };

    root.querySelectorAll<HTMLButtonElement>('.ctl').forEach((b) =>
      b.addEventListener('click', () => { stop(); show(i + Number(b.dataset.dir)); })
    );
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { stop(); show(i + 1); }
      if (e.key === 'ArrowLeft') { stop(); show(i - 1); }
    });
    // Pause while the visitor is reading or interacting.
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }
</script>
