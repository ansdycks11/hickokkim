---
/**
 * Featured service page on its own top-level URL (docs/website-architecture.md §4, §6.2).
 * Uses the same body template as the practice-area pages; content lives in
 * src/data/practice/outside-general-counsel.ts.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PracticePage from '../components/PracticePage.astro';
import { areaBySlug, SITE_URL, FIRM_ID } from '../data/firm';
import { contentFor } from '../data/practice';

const area = areaBySlug('outside-general-counsel')!;
const content = contentFor('outside-general-counsel');
if (!content) {
  throw new Error('Missing src/data/practice/outside-general-counsel.ts');
}

const crumbs = [{ name: 'Outside General Counsel', href: area.path }];

const serviceSchema = {
  '@type': 'Service',
  '@id': `${SITE_URL}${area.path}#service`,
  name: 'Outside General Counsel — Los Angeles',
  serviceType: area.schemaName,
  description: content.definition,
  provider: { '@id': FIRM_ID },
  areaServed: { '@type': 'State', name: 'California' },
  url: `${SITE_URL}${area.path}`,
  offers: { '@type': 'Offer', description: 'Free initial consultation', price: '0', priceCurrency: 'USD' },
};

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${SITE_URL}${area.path}#faq`,
  mainEntity: content.questions.map((qa) => ({
    '@type': 'Question',
    name: qa.q,
    acceptedAnswer: { '@type': 'Answer', text: qa.a },
  })),
};
---

<Base
  title={content.title}
  description={content.description}
  path={area.path}
  breadcrumbs={crumbs}
  schema={[serviceSchema, faqSchema]}
>
  <PageHero
    breadcrumbs={crumbs}
    aside={{ label: 'Related professionals', href: '#professionals' }}
  >
    {area.name}
  </PageHero>

  <PracticePage content={content} leads={area.partners} areaName="Outside general counsel" />
</Base>
