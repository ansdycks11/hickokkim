---
/** Featured service page (own top-level URL). Full content in Phase 3. */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { areaBySlug, partners, firm, SITE_URL, FIRM_ID } from '../data/firm';

const area = areaBySlug('outside-general-counsel')!;
const leads = area.partners.map((s) => partners[s]);
const title = 'Outside General Counsel | Hickok & Kim Inc. — Los Angeles';
const description =
  'Outside general counsel for Los Angeles and California businesses: ongoing contract review, advice on decisions, and disputes handled as they arise, without the cost of an in-house lawyer.';
const crumbs = [{ name: 'Outside General Counsel', href: area.path }];

const serviceSchema = {
  '@type': 'Service',
  '@id': `${SITE_URL}${area.path}#service`,
  name: 'Outside General Counsel — Los Angeles',
  serviceType: area.schemaName,
  description: area.blurb,
  provider: { '@id': FIRM_ID },
  areaServed: { '@type': 'State', name: 'California' },
  url: `${SITE_URL}${area.path}`,
  offers: { '@type': 'Offer', description: 'Free initial consultation', price: '0', priceCurrency: 'USD' },
};
---

<Base title={title} description={description} path={area.path} breadcrumbs={crumbs} schema={[serviceSchema]}>
  <PageHero kicker={`${area.ref} · Featured service · ${leads.map((p) => p.name).join(' and ')}`} breadcrumbs={crumbs} cta>
    Your company's legal department, <em>without</em> the in-house cost.
  </PageHero>

  <section class="block">
    <div class="wrap-narrow prose">
      <div class="quick-answer">
        <span class="mono-label">Quick answer</span>
        <p>Outside general counsel is an ongoing arrangement in which a law firm acts as a company's legal department: reviewing contracts, advising on decisions, handling disputes as they arise, and keeping the company's legal house in order.</p>
        <p>At Hickok &amp; Kim, outside general counsel engagements are led by both partners, Daniel J. Kim and Christopher D. Hickok, for businesses in Los Angeles and across California. Every engagement begins with a free consultation and a written retainer agreement.</p>
      </div>
      <p class="placeholder">Service-model detail, engagement structure, and pricing are <code>TODO:REAL-DATA</code> (partners to supply). Full page content follows in Phase 3.</p>
      <p class="reviewed">Last reviewed {firm.lastReviewed}</p>
    </div>
  </section>

  <CtaBand heading="Talk to a partner about ongoing counsel." />
</Base>
