---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import LawyerList from '../../components/LawyerList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { partnerList } from '../../data/firm';

const title = 'Attorneys | Hickok & Kim — Los Angeles';
const description =
  'The two partners of Hickok & Kim in Los Angeles: Daniel Kim, litigation and estates, and Christopher Hickok, cannabis and trademarks.';
const crumbs = [{ name: 'Attorneys', href: '/attorneys/' }];
---

<Base title={title} description={description} path="/attorneys/" breadcrumbs={crumbs}>
  <PageHero breadcrumbs={crumbs} aside={{ label: 'Practice areas', href: '/practice-areas/' }}>Lawyers</PageHero>

  <Section label="Overview" tone="mist">
    <p class="lead">Hickok &amp; Kim, Inc. has two partners and no associates. The partner who takes your consultation is the partner who does the work and signs your engagement letter.</p>
  </Section>

  <Section label="Partners" tone="white">
    <LawyerList slugs={partnerList.map((p) => p.slug)} headingLevel="h3" />
  </Section>

  <CtaBand />
</Base>
