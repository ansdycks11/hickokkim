---
/** Attorney bio. Hero with name, rule, and vCard; headshot overlapping the Overview section. */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import CtaBand from '../../components/CtaBand.astro';
import { partnerList, areasForPartner, firm, lastReviewedDisplay } from '../../data/firm';

export function getStaticPaths() {
  return partnerList.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const areas = areasForPartner(p.slug);
const title = `${p.name} | Hickok & Kim — Los Angeles`;
const description = `${p.name}, Partner at Hickok & Kim in Los Angeles. ${p.focusSummary} California State Bar #${p.barNumber}.`;
const crumbs = [
  { name: 'Attorneys', href: '/attorneys/' },
  { name: p.name, href: p.path },
];
const profileSchema = {
  '@type': 'ProfilePage',
  '@id': `${p.url}#profile`,
  mainEntity: { '@id': p.id },
  dateModified: firm.lastReviewed,
};
---

<Base title={title} description={description} path={p.path} breadcrumbs={crumbs} schema={[profileSchema]} ogImage={`${firm.url}${p.image}`}>
  <PageHero breadcrumbs={crumbs} aside={{ label: 'vCard', href: `/vcard/${p.slug}.vcf` }} sub={[{ label: p.title }, { label: 'Hickok & Kim, Inc.' }]}>
    {p.name}
  </PageHero>

  <section class="bio-top" aria-label="Photo and contact">
    <div class="wrap bio-top__grid">
      <!-- TODO:REAL-DATA — full-resolution headshot (>=1200px short edge), 4:5 crop. -->
      <img class="bio-photo" src={p.image} width={p.imageWidth} height={p.imageHeight} alt={p.imageAlt} />
      <p class="bio-contact">
        <a href={`tel:${firm.phoneTel}`}>{firm.phoneDisplay}</a><br />
        <a href={`mailto:${firm.email}`}>{firm.email}</a><br />
        Los Angeles · {p.languages.join(', ')}{p.languages.includes('Korean') ? ' (한국어)' : ''}
      </p>
    </div>
  </section>

  <Section label="Overview" tone="mist">
    <p class="lead">{p.shortBio}</p>
    {p.humanizing && <p>{p.humanizing}</p>}
    <p class="placeholder">Full biography (300–500 words, client-outcome oriented) is written in Phase 4 for partner review.</p>
  </Section>

  <Section label="Credentials" tone="white">
    <div class="prose table-scroll">
      <table>
        <tbody>
          <tr><th scope="row">Bar admission</th><td>State Bar of California <a href={p.barProfile} rel="noopener">#{p.barNumber}</a>, admitted {p.barAdmitted}, Active</td></tr>
          {p.federalAdmissions.length > 0 && <tr><th scope="row">Federal courts</th><td>{p.federalAdmissions.join('; ')}</td></tr>}
          <tr><th scope="row">Education</th><td>{p.education.join('; ')}</td></tr>
          <tr><th scope="row">Experience</th><td>{p.experience.join('; ')}</td></tr>
          {p.memberships.length > 0 && <tr><th scope="row">Leadership</th><td>{p.memberships.join('; ')}</td></tr>}
          <tr><th scope="row">Languages</th><td>{p.languages.join(', ')}</td></tr>
        </tbody>
      </table>
    </div>
  </Section>

  <Section label="Practice areas" tone="mist">
    <ul class="linklist">
      {areas.map((a) => <li><a href={a.path}>{a.name}</a><span class="note">{a.blurb}</span></li>)}
    </ul>
    <p class="reviewed">Last reviewed {lastReviewedDisplay}</p>
  </Section>

  <CtaBand heading={`Talk to ${p.firstName}. The first conversation is free.`} />
</Base>

<style>
  .bio-top { background: var(--mist); padding-top: clamp(32px, 4vw, 48px); }
  .bio-top__grid { display: grid; grid-template-columns: auto 1fr; gap: 20px 32px; align-items: end; padding-bottom: 8px; }
  .bio-photo { width: clamp(150px, 20vw, 220px); aspect-ratio: 4 / 5; object-fit: cover; background: var(--mist-2); }
  .bio-contact { padding-bottom: 12px; line-height: 1.9; font-size: .95rem; }
  .bio-contact a { color: var(--accent); text-decoration: none; }
  .bio-contact a:hover { text-decoration: underline; }
  @media (max-width: 560px) { .bio-top__grid { grid-template-columns: 1fr; } }
</style>
