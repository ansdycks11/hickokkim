---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import IntakeForm from '../../components/IntakeForm.astro';
import { firm } from '../../data/firm';

const title = 'Contact & Free Consultation | Hickok & Kim — LA';
const description =
  'Free consultation with Hickok & Kim in Los Angeles. Call (213) 373-7188 or send a short message. A partner responds within one business day.';
const crumbs = [{ name: 'Contact', href: '/contact/' }];

// OpenStreetMap embed (no API key).
const d = 0.006;
const bbox = [firm.geo.lng - d, firm.geo.lat - d, firm.geo.lng + d, firm.geo.lat + d].join('%2C');
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${firm.geo.lat}%2C${firm.geo.lng}`;
const mapLink = `https://www.openstreetmap.org/?mlat=${firm.geo.lat}&mlon=${firm.geo.lng}#map=17/${firm.geo.lat}/${firm.geo.lng}`;

const contactSchema = {
  '@type': 'ContactPage',
  '@id': `${firm.url}/contact/#contactpage`,
  mainEntity: { '@id': `${firm.url}/#firm` },
};
---

<Base title={title} description={description} path="/contact/" breadcrumbs={crumbs} schema={[contactSchema]} hideStickyCta>
  <PageHero breadcrumbs={crumbs} aside={{ label: firm.phoneDisplay, href: `tel:${firm.phoneTel}` }}>Contact</PageHero>

  <Section label="Consultation" tone="mist">
    <p class="lead">The first conversation is free. Tell us briefly what's going on, and a partner responds {firm.responsePromise}.</p>
    <div class="on-light"><IntakeForm /></div>
  </Section>

  <Section label="Office" tone="white">
    <div class="office">
      <address>
        <strong>{firm.name}</strong><br />
        {firm.address.street}<br />
        {firm.address.city}, {firm.address.region} {firm.address.postal}<br />
        {firm.address.note} (virtual office; in-person meetings scheduled in advance)<br />
        <a href={`tel:${firm.phoneTel}`}>{firm.phoneDisplay}</a><br />
        <a href={`mailto:${firm.email}`}>{firm.email}</a><br />
        {firm.hoursDisplay}<br />
        {firm.hoursNote}<br />
        English · 한국어 상담 가능
      </address>
      <div>
        <div class="map">
          <iframe src={mapSrc} title="Map showing the Hickok & Kim office at 2202 S. Figueroa St., Los Angeles" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <p><a class="textlink chev" href={mapLink} rel="noopener">Open in OpenStreetMap</a></p>
      </div>
    </div>
    <!-- TODO:REAL-DATA — parking / transit note (partners reported none). -->
  </Section>

  <Section label="What happens next" tone="mist">
    <ol class="steps">
      <li><h3>We read it</h3><p>A partner reads your message and responds {firm.responsePromise}.</p></li>
      <li><h3>We talk</h3><p>A free consultation by phone or video, or in person by appointment.</p></li>
      <li><h3>We agree in writing</h3><p>If we can help, a written retainer agreement spells out the fee structure before any work begins.</p></li>
    </ol>
    <p class="note-box"><strong>No attorney-client relationship is formed by using this site.</strong> Sending a message, calling, or emailing does not make Hickok &amp; Kim your lawyers and does not obligate the firm to represent you. Please do not send confidential details until we have confirmed in writing that we can take your matter. See our <a class="textlink" href="/disclaimer/">disclaimer</a>.</p>
  </Section>
</Base>

<style>
  .office { display: grid; gap: 32px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .office { grid-template-columns: 1fr 1.3fr; } }
  .office address { font-style: normal; line-height: 1.9; }
  .office address a { color: var(--accent); text-decoration: none; }
  .office address a:hover { text-decoration: underline; }
  .map { aspect-ratio: 16 / 10; background: var(--mist); border: 1px solid var(--hair); }
  .map iframe { display: block; width: 100%; height: 100%; border: 0; filter: grayscale(.6); }
</style>
