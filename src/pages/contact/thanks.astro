---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { firm } from '../../data/firm';

const title = 'Message Received | Hickok & Kim — Los Angeles';
const description = 'Thank you. A partner at Hickok & Kim, Inc. will respond within one business day, usually the same day.';
const crumbs = [{ name: 'Contact', href: '/contact/' }, { name: 'Message received', href: '/contact/thanks/' }];
---

<Base title={title} description={description} path="/contact/thanks/" breadcrumbs={crumbs} noindex hideStickyCta>
  <PageHero breadcrumbs={crumbs}>Message Received</PageHero>
  <Section label="What happens next" tone="mist">
    <p class="lead">Thank you. A partner, not an intake service, reads your message and replies by phone or email {firm.responsePromise}.</p>
    <ol class="steps">
      <li><h3>A reply</h3><p>By phone or email {firm.responsePromise}.</p></li>
      <li><h3>A free consultation</h3><p>By phone or video, or in person by appointment at our Los Angeles office.</p></li>
      <li><h3>A written agreement</h3><p>If we can help, a retainer agreement spells out the fee structure before any work begins.</p></li>
    </ol>
    <p>Need to reach us sooner? Call <a class="textlink" href={`tel:${firm.phoneTel}`}>{firm.phoneDisplay}</a>, {firm.hoursDisplay}.</p>
    <p class="muted">Contacting us does not create an attorney-client relationship until a retainer agreement is signed.</p>
  </Section>
</Base>
