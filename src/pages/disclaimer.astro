---
/** Attorney-advertising disclaimer. Marked for attorney review before launch. */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { firm } from '../data/firm';

const title = 'Disclaimer | Hickok & Kim Inc. — Los Angeles';
const description = 'Attorney advertising disclaimer for hickokkim.com. No attorney-client relationship is formed by using this site. Prior results do not guarantee a similar outcome.';
const crumbs = [{ name: 'Disclaimer', href: '/disclaimer/' }];
---

<Base title={title} description={description} path="/disclaimer/" breadcrumbs={crumbs}>
  <PageHero kicker="Disclaimer" breadcrumbs={crumbs} scales={false}>Disclaimer</PageHero>
  <section class="block">
    <div class="wrap-narrow prose">
      <p class="meta">Last reviewed {firm.lastReviewed}. <!-- TODO:REAL-DATA — attorney review before launch. --></p>

      <h2>Attorney advertising</h2>
      <p>This website is a communication from {firm.name}, a California law firm, and may be considered attorney advertising under the California Rules of Professional Conduct. Prior results do not guarantee a similar outcome. Every matter depends on its own facts.</p>

      <h2>No attorney-client relationship</h2>
      <p>Using this site, reading its content, or contacting the firm by form, phone, or email does not create an attorney-client relationship. The firm becomes your lawyer only when both you and the firm sign a written retainer agreement. Until then, please do not send confidential information, and understand that anything you send may not be treated as privileged.</p>

      <h2>Not legal advice</h2>
      <p>The information on this site is general and educational. It is not legal advice and should not be relied on as a substitute for advice about your specific situation from a lawyer licensed in your state. Laws change; the "last reviewed" date on each page shows when its content was last checked.</p>

      <h2>Jurisdiction</h2>
      <p>The attorneys of {firm.name} are licensed to practice in California. The firm does not seek to represent anyone in a jurisdiction where this site does not comply with applicable rules.</p>

      <h2>Cannabis matters</h2>
      <p>Cannabis remains a controlled substance under federal law. Content on this site about California cannabis licensing and compliance describes state and local law and does not advise anyone to violate federal law.</p>

      <h2>Contingency fees</h2>
      <p>Where a matter is handled on a contingency basis, the client may still be responsible for costs and expenses as set out in the written retainer agreement.</p>

      <h2>Contact</h2>
      <p>Questions about this disclaimer: <a href={`mailto:${firm.email}`}>{firm.email}</a>.</p>
    </div>
  </section>
</Base>
