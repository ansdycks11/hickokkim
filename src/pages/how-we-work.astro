---
/** Process + fees. Phase 4 expands this with the consultation checklist. */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import { lastReviewedDisplay } from '../data/firm';

const title = 'How We Work & Fees | Hickok & Kim — Los Angeles';
const description =
  'How Hickok & Kim works: free consultation, written retainer, itemized invoices. Hourly, flat-fee, and contingency options in Los Angeles.';
const crumbs = [{ name: 'How we work', href: '/how-we-work/' }];
const steps = [
  { t: 'Free consultation', d: "A call or video meeting where we listen, ask questions, and tell you plainly whether we're the right firm. If we're not, we'll point you to someone who is." },
  { t: 'Retainer and conflict check', d: 'A written retainer agreement and conflict waiver before any work begins, with the fee structure spelled out: hourly, flat, or contingency.' },
  { t: 'Strategy and itemized invoices', d: 'A clear plan, itemized invoices, and a partner who returns calls the same day in nearly every case.' },
  { t: 'Resolution', d: 'Settlement, signature, filing, or judgment. We drive matters to a defined end and hand you the complete file.' },
];
---

<Base title={title} description={description} path="/how-we-work/" breadcrumbs={crumbs}>
  <PageHero breadcrumbs={crumbs} aside={{ label: 'Free consultation', href: '/contact/' }}>How We Work</PageHero>

  <Section label="Overview" tone="mist">
    <p class="lead">Four steps, a written agreement before any work begins, and a partner who returns calls the same day in nearly every case.</p>
  </Section>

  <Section label="Process" tone="white">
    <ol class="steps">
      {steps.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}
    </ol>
  </Section>

  <Section label="Fees" tone="mist">
    <div class="prose">
      <p>Hickok &amp; Kim, Inc. bills hourly, at a flat fee, or on contingency, depending on the matter. Personal injury cases are handled on contingency, which means no fee unless we recover for you. Business, corporate, trademark, cannabis, estate-planning, and real-estate work is billed hourly or at a flat fee agreed in advance. Every engagement starts with a written retainer agreement and a conflict check, and invoices are itemized.</p>
    </div>
    <p class="placeholder">Phase 4 adds the expanded fee explanation, the "what to bring to a first consultation" checklist, and communication promises.</p>
    <p class="reviewed">Last reviewed {lastReviewedDisplay}</p>
  </Section>

  <CtaBand />
</Base>
